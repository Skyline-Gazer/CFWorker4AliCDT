# Dependencies
node_modules/

# Wrangler local state and build output
.wrangler/

# Generated at deploy time with the D1 id injected; never committed (see
# scripts/resolve-deploy-config.mjs). Distinct from wrangler.jsonc so Wrangler
# never picks it up implicitly.
wrangler.deploy.jsonc
dist/
worker-configuration.d.ts

# Test output
coverage/

# CodeGraph local index
.codegraph/

# Secrets — never commit any of these
.dev.vars
.env
.env.*
!.env.example

# Editor and OS noise
.DS_Store
*.log
