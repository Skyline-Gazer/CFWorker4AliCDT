# Dependencies
node_modules/

# Wrangler local state and build output
.wrangler/

# Generated deployment configs. They are written at the repository root because
# Wrangler resolves `main` relative to the config's directory, and they are
# gitignored so no production identifier ever enters the tracked tree. Distinct
# filenames from wrangler.jsonc, so Wrangler never picks one up implicitly (see
# scripts/resolve-deploy-config.mjs).
wrangler.deploy.jsonc
wrangler.preflight.jsonc

# Scratch configs written at the repository root by the tests that exercise the
# real resolver. They must be at the root because Wrangler resolves `main`
# relative to the config's directory, and the resolver refuses any other
# location. Each test file uses a distinct filename so parallel test files do not
# race on one path.
wrangler.test-*.jsonc
dist/
worker-configuration.d.ts

# Test output
coverage/

# CodeGraph local index
.codegraph/

# Secrets — never commit any of these
.dev.vars
.env
.env.*
!.env.example

# Editor and OS noise
.DS_Store
*.log
