{
  // Cloudflare Worker that enforces an Alibaba Cloud CDT traffic threshold by
  // starting and stopping a single ECS instance. See docs/planning/project-spec.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cfworker4alicdt",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",

  // Scheduled-only Worker. No public control surface is exposed; the fetch
  // handler serves GET /health and nothing else (SPEC §8).
  "workers_dev": false,

  // SPEC §11: every 10 minutes. 5-field Quartz-like expression.
  "triggers": {
    "crons": ["*/10 * * * *"],
  },

  // The Workers Free platform CPU allowance applies automatically. Custom
  // limits.cpu_ms is unsupported on Free; see docs/operations/deployment.md §7.

  // Deployment fails loudly if any of these is missing, rather than failing at
  // the first scheduled run (SPEC §2.1). Never put values here.
  //
  // `ADMIN_TOKEN` is listed as required because SPEC §2.1 marks it so: without it
  // every dashboard and API route denies (SPEC §8.3), which is a fail-closed
  // outcome but not a working deployment. `WEBHOOK_TOKEN` is deliberately absent
  // because SPEC §2.1 marks it optional — requiring it would reject a valid
  // deployment that uses an unauthenticated webhook endpoint.
  "secrets": {
    "required": ["ALIYUN_ACCESS_KEY_ID", "ALIYUN_ACCESS_KEY_SECRET", "WEBHOOK_URL", "ADMIN_TOKEN"],
  },

  // Non-secret defaults, matching SPEC §2.2 field-for-field. This file is the
  // single place a default is stated.
  "vars": {
    "TRAFFIC_THRESHOLD_GB": "180",
    "CDT_ENDPOINT": "cdt.aliyuncs.com",
    "SIGNATURE_VERSION": "v3",
    "STOPPED_MODE": "KeepCharging",
    // REGION_ID and ECS_INSTANCE_ID are required and deliberately have no
    // default. BUSINESS_REGION_ID is optional and unset by default.
  },

  "observability": {
    "enabled": true,
  },

  // D1 monitoring history (SPEC §9.3). The binding is declared without a
  // `database_id`: the field is documented as optional, and the local
  // development and test path uses Wrangler's local D1 emulation only. No
  // remote database is provisioned or referenced here, so a production
  // `database_id` is supplied at deploy time by the owner, not invented here.
  "d1_databases": [
    {
      "binding": "TRAFFIC_DB",
      "database_name": "cfworker4alicdt-traffic",
      "migrations_dir": "migrations",
    },
  ],
}
