{
  "name": "cfworker4alicdt",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker that enforces an Alibaba Cloud CDT traffic threshold by starting and stopping a single ECS instance.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run deploy:dry-run"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@eslint/js": "^9.13.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^2.1.4",
    "eslint": "^9.13.0",
    "js-yaml": "^4.3.2",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.2",
    "vitest": "^2.1.4",
    "wrangler": "^4.135.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "sharp@0.33.5": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260918.1": true,
    "fsevents@2.3.3": true
  }
}
